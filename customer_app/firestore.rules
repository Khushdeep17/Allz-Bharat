rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles
    // Authenticated users can read and write only their own profile document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // 2. User Delivery Addresses Subcollection
      // Authenticated users can read and write only addresses under their own UID.
      match /addresses/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 3. Categories Collection
    // Public read-only for customer clients; customer clients must not write.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Shops Collection
    // Public read-only for customer clients; customer clients must not write.
    match /shops/{shopId} {
      allow read: if true;
      allow write: if false;
    }

    // 5. Products Collection
    // Public read-only for customer clients; customer clients must not write.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // 6. Payment Intents Collection
    // Created and managed by trusted Cloud Functions backend.
    // Customers can read only their own payment intent documents; no customer direct writes.
    match /payment_intents/{intentId} {
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      allow write: if false;
    }

    // 7. Orders Collection
    // Top-level collection. Final orders are created exclusively by trusted Cloud Functions Admin SDK.
    // Direct client order creation is disabled.
    // Customers can read only their own orders.
    // Customers can cancel (update) an order only while it is pending.
    // Customers can NEVER update paymentStatus, paymentId, paymentOrderId, pricing, or other fields.
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      allow create: if false;
      allow update: if request.auth != null
        && resource.data.customerId == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.status == "cancelled"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "cancelledAt", "cancellationReason"]);
      allow delete: if false;
    }
  }
}
