{
  "name": "allz-bharat-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions backend for Allz Bharat",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "tsc && node --test lib/test/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  },
  "private": true
}
